# ==============================================================================
# SMART HOME ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# ==============================================================================

TIMEZONE=Asia/Ho_Chi_Minh

# --- Telegram Bot Credentials ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# --- Home Assistant Local Access ---
HA_BASE_URL=http://localhost:8123
HA_ACCESS_TOKEN=your_home_assistant_long_lived_access_token_here

# --- Mosquitto MQTT Broker ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# --- Camera Snapshot Endpoint (ESP32-CAM) ---
CAM_SNAPSHOT_URL=http://localhost:8081/saved_photo.jpg

# --- Supabase Database & Storage Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET_NAME=security-snapshots

# --- CompreFace Face AI Database Credentials ---
COMPREFACE_DB_USER=postgres
COMPREFACE_DB_PASS=postgres
COMPREFACE_API_KEY=your_compreface_recognition_service_api_key
